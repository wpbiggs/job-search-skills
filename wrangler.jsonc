{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-search-workspace",
  "main": "src/worker.ts",
  "account_id": "b7019b91654de6e62fb986cd0864cba2",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node scripts/build-web.mjs" },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "vars": { "PUBLIC_ORIGIN": "https://william.biggers.family", "RP_ID": "william.biggers.family" },
  "d1_databases": [{ "binding": "DB", "database_name": "job-search-workspace", "database_id": "8fa1f985-c680-406e-96d8-465bfbd4516b", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "12478c9ab529403cac7ebeae40f1c81a" }],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "599176341", "simple": { "limit": 12, "period": 60 } },
    { "name": "REQUEST_LIMIT", "namespace_id": "599176342", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true, "head_sampling_rate": 0.05 } },
  "routes": [
    { "pattern": "william.biggers.family/job-search/workspace*", "zone_name": "biggers.family" },
    { "pattern": "william.biggers.family/job-search/api/*", "zone_name": "biggers.family" },
    { "pattern": "william.biggers.family/job-search/mcp*", "zone_name": "biggers.family" },
    { "pattern": "william.biggers.family/job-search/oauth/*", "zone_name": "biggers.family" },
    { "pattern": "william.biggers.family/.well-known/oauth-authorization-server/job-search*", "zone_name": "biggers.family" },
    { "pattern": "william.biggers.family/.well-known/oauth-protected-resource/job-search/mcp*", "zone_name": "biggers.family" }
  ]
}
